# Project Garnet — Hardware & Partition Specifications
# Extracted from reference/android_device_xiaomi_garnet/BoardConfig.mk & overlay/

TARGET_DEVICE="garnet"
TARGET_PRODUCT_NAME="Redmi Note 13 Pro 5G / POCO X6 5G (China)"
TARGET_PLATFORM="parrot"
TARGET_SOC="SM7435-AB (Snapdragon 7s Gen 2)"
TARGET_BOOTLOADER_BOARD_NAME="parrot"
TARGET_ARCH="arm64"
TARGET_CPU_ABI="arm64-v8a"
TARGET_2ND_CPU_ABI="armeabi-v7a"

# Kernel & Boot Image
BOARD_KERNEL_PAGESIZE=4096
BOARD_BOOT_HEADER_VERSION=4
BOARD_BOOTIMAGE_PARTITION_SIZE=201326592        # 192 MiB
BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE=100663296  # 96 MiB
BOARD_DTBOIMG_PARTITION_SIZE=25165824            # 24 MiB
BOARD_RECOVERYIMAGE_PARTITION_SIZE=104857600     # 100 MiB

# Super & Dynamic Partitions (A/B)
AB_OTA_UPDATER=true
BOARD_SUPER_PARTITION_SIZE=9663676416            # 9.0 GiB (9,663,676,416 bytes)
BOARD_QTI_DYNAMIC_PARTITIONS_SIZE=9659482112     # SUPER_SIZE - 4 MiB (9,659,482,112 bytes)
BOARD_FLASH_BLOCK_SIZE=131072                    # 4096 * 64
BOARD_SUPER_PARTITION_GROUPS="qti_dynamic_partitions"
BOARD_QTI_DYNAMIC_PARTITIONS_PARTITION_LIST="product system system_ext odm vendor vendor_dlkm"

# Display & Optical FOD
TARGET_SCREEN_WIDTH=1220
TARGET_SCREEN_HEIGHT=2712
TARGET_SCREEN_DENSITY=480
TARGET_STATUS_BAR_HEIGHT_PX=110
TARGET_ROUNDED_CORNER_RADIUS_PX=110
TARGET_FOD_TYPE="udfps_optical"
TARGET_FOD_SENSOR_LOCATION="610|2437|105"        # X=610, Y=2437, Radius=105 px

# Target Stock Base & Donor Configuration
GARNET_BASE_VERSION="OS3.0.306.0.WNRCNXM"
GARNET_BASE_ANDROID="16"
DONOR_DEVICE_MODEL="PKJ110"
DONOR_DEVICE_NAME="OPPO Find X8 Ultra (China)"
DONOR_COLOROS_VERSION="17"
DONOR_ANDROID_VERSION="17"
